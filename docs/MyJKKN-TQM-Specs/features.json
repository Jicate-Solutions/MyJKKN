        "types/stakeholder-nps.ts",
        "supabase/migrations/20260201000001_create_nps_tables.sql"
      ],
      "test_steps": [
        {
          "step": 1,
          "action": "Create NPS survey",
          "input": "Survey for Parents, title 'Semester Feedback Q1 2026'",
          "expected": "Survey created with status 'draft', visible in surveys list"
        },
        {
          "step": 2,
          "action": "Add custom questions",
          "input": "Add 2 additional questions: text and rating type",
          "expected": "Questions saved in survey.questions JSONB"
        },
        {
          "step": 3,
          "action": "Activate survey",
          "input": "Click 'Activate' button",
          "expected": "Status changes to 'active', survey appears for target stakeholders"
        },
        {
          "step": 4,
          "action": "Submit NPS response",
          "input": "Score: 9, Feedback: 'Great experience'",
          "expected": "Response saved, nps_category = 'promoter' (computed)"
        },
        {
          "step": 5,
          "action": "Submit detractor response",
          "input": "Score: 4, Feedback: 'Needs improvement'",
          "expected": "Response saved, nps_category = 'detractor'"
        },
        {
          "step": 6,
          "action": "View analytics",
          "input": "Navigate to /stakeholder-nps/analytics",
          "expected": "Shows NPS score = 0 (1 promoter - 1 detractor = 0%)"
        },
        {
          "step": 7,
          "action": "Filter by stakeholder type",
          "input": "Select 'Parent' filter",
          "expected": "Only parent surveys and responses shown"
        },
        {
          "step": 8,
          "action": "View department breakdown",
          "input": "Expand department view in analytics",
          "expected": "NPS scores grouped by department"
        },
        {
          "step": 9,
          "action": "Close survey",
          "input": "Click 'Close Survey' button",
          "expected": "Status changes to 'closed', no new responses accepted"
        },
        {
          "step": 10,
          "action": "Export responses",
          "input": "Click 'Export CSV' button",
          "expected": "CSV downloaded with all responses including nps_category"
        }
      ]
    },
