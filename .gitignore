# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Windows / Git Bash crash dumps
*.stackdump

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# This project uses npm exclusively (matches CI / Vercel). Block other PMs' lockfiles.
bun.lock
bun.lockb
pnpm-lock.yaml
yarn.lock

# testing
/coverage

# next.js
.next
/out/

# production
/build

# misc
.DS_Store
*.pem

# Claude Code
CLAUDE.md

# Claude Code subagent scratch files (commit message drafts, tsc output captures)
.commit-msg*.tmp
.git-commit-msg*.tmp
.tsc-out*.txt
tsc-output*.log

# SAML certificates (private keys must never be committed)
certs/saml/*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
/.build*.log

# env files (can opt-in for commiting if needed)
.env*

# Import script env (Phase 7 staff extended fields)
.env.import

# MCP server config — contains Supabase management bearer token
.mcp.json

# Import script run logs
scripts/import/runs/*.log

# test files
test-jwt-secret.js

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
nul
tmpclaude-b3ce-cwd
tmpclaude-*

# git worktrees
.worktrees/
.claude/worktrees/

# Build logs (test artifacts, not for commit)
build.log
build-*.log
docs/features/mathswork/SAML_PRIVATE_KEY_B64.txt
docs/features/mathswork/SAML_PUBLIC_CERTIFICATE_B64.txt
docs/features/mathswork/myjkkn-saml-private.pem

# Serwist PWA (generated at build time)
public/sw.js
public/sw.js.map
public/swe-worker-*.js
public/swe-worker-*.js.map
.worktrees/
.worktree
# Auto-generated session context for Claude Code
.claude/session-context.md

# Sentry Config File
.env.sentry-build-plugin

# Agent worktrees (created by parallel sub-agent runs in interactive sessions)
.claude/worktrees/

# /loop & /schedule runtime state — session ID + PID, not feature work
.claude/scheduled_tasks.lock

.screenshots/

# CodeGraph index (local, per-machine)
.codegraph/

# MSYS/Cygwin bash crash dumps on Windows
*.stackdump
