public/sw.js
public/sw.js.map
public/swe-worker-*.js
public/swe-worker-*.js.map
.worktrees/
.worktree
# Auto-generated session context for Claude Code
.claude/session-context.md

# Sentry Config File
.env.sentry-build-plugin

# Razorpay per-institution credential seed file (plaintext secrets — never commit)
razorpay-accounts.seed.json

# Agent worktrees (created by parallel sub-agent runs in interactive sessions)
.claude/worktrees/

# /loop & /schedule runtime state — session ID + PID, not feature work
.claude/scheduled_tasks.lock

.screenshots/

# CodeGraph index (local, per-machine)
.codegraph/

# MSYS/Cygwin bash crash dumps on Windows
*.stackdump

.playwright-mcp/

# Python bytecode
__pycache__/
*.pyc

# guide-driven-testing generated artifacts (regenerated by gen:guide-e2e / gen:guide-load)
/e2e/guide-nav.generated.spec.ts
/load/guide-load.js

# Playwright E2E auth storageState (per-persona session tokens) + run outputs — never commit
.auth/
/test-results/
/playwright-report/

# Local fee-sync analysis artifacts (contain student PII) — keep out of git.
# Anchored to the repo root: unanchored `reports/` matched any directory named
# `reports` at any depth, silently swallowing new source files in the 13 real
# reports/ source dirs (app/(routes)/billing/reports, lib/services/billing/reports,
# app/(routes)/academic/attendance/reports, …). git add skips them without error.
/reports/

# Local audit artifacts (contain production figures and real learner records) — keep out
# of git. Not build output: these are self-contained HTML reports plus their JSON data
# backups, written straight from the production database (e.g. a reading-programme audit
# carrying 336 rows of real learner reading records). They were only ever untracked, which
# is not protection — a repo-root `git add -A` would commit them.
# Anchored to the repo root for the same reason as /reports/ above: an unanchored
# `artifacts/` would match any directory named `artifacts` at any depth and silently
# swallow real source files, with git add skipping them without error.
/artifacts/

# local secrets / config (never commit)
env
mcp.json

# Generated per-PR by .github/workflows/typecheck-pr-scoped.yml — never committed.
tsconfig.pr-scoped.json

/proposals