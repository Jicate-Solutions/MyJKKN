# env files (can opt-in for commiting if needed)
.env*
!.env.example

# test files
test-jwt-secret.js

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
nul
tmpclaude-b3ce-cwd
tmpclaude-*

