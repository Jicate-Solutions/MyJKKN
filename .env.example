# Pepper for IP-hash daily salt (rotate annually). 32+ random chars.
IP_HASH_PEPPER=

# ============================================================================
# Razorpay (HDFC Collect Now) Payment Gateway
# ============================================================================
# Per-module provider selection. Default is 'hdfc_smartgateway' when unset.
# Flip to 'razorpay' to cut over a module to the Razorpay backend.
BILLING_PAYMENT_PROVIDER=hdfc_smartgateway
EVENTS_PAYMENT_PROVIDER=hdfc_smartgateway

# Razorpay API credentials. Get from https://dashboard.razorpay.com/app/keys
# In test mode: keys start with `rzp_test_`. In live mode: `rzp_live_`.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Webhook secret configured on the Razorpay dashboard's Webhook settings page.
# Used to verify the X-Razorpay-Signature header on inbound webhook POSTs.
RAZORPAY_WEBHOOK_SECRET=

# ============================================================================
# Instagram (Meta) Webhook
# ============================================================================
# Verify token: a random string YOU choose; enter the same value in
# Meta App → Webhooks → Instagram → Edit → Verify Token.
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=
# App Secret from Meta App → Settings → Basic → App Secret.
# Used to verify the X-Hub-Signature-256 header on every inbound webhook POST.
INSTAGRAM_WEBHOOK_SECRET=
