.commit-msg*.tmp
.git-commit-msg*.tmp
.tsc-out*.txt
tsc-output*.log

# SAML certificates (private keys must never be committed)
certs/saml/*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
/.build*.log

# env files (can opt-in for commiting if needed)
.env*

# Import script env (Phase 7 staff extended fields)
.env.import

# MCP server config — contains Supabase management bearer token
.mcp.json
/mcp.json

# Local env file without leading dot (contains real secrets)
/env

# Local dev server run logs
/dev-run.log
/dev-server-run.log

# Import script run logs
scripts/import/runs/*.log

# test files
test-jwt-secret.js

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
nul
tmpclaude-b3ce-cwd
tmpclaude-*

# git worktrees
.worktrees/
.claude/worktrees/

# Build logs (test artifacts, not for commit)
build.log
build-*.log
docs/features/mathswork/SAML_PRIVATE_KEY_B64.txt
docs/features/mathswork/SAML_PUBLIC_CERTIFICATE_B64.txt
docs/features/mathswork/myjkkn-saml-private.pem

