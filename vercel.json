{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "regions": ["bom1"],
  "git": {
    "deploymentEnabled": false
  },
  "crons": [
    {
      "path": "/api/cron/notification-processor?secret=${CRON_SECRET}",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/dashboard/cron/refresh-sla-leaderboard",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/dashboard/cron/refresh-conversion-leaderboard",
      "schedule": "30 18 * * *"
    },
    {
      "path": "/api/dashboard/cron/ghost-sweep",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/dashboard/cron/queue-escalate",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/sunday-wrap?secret=${CRON_SECRET}",
      "schedule": "30 15 * * 0"
    },
    {
      "path": "/api/cron/friday-reflection?secret=${CRON_SECRET}",
      "schedule": "30 10 * * 5"
    }
  ]
}
