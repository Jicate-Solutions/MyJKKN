        {
          "step": 1,
          "action": "Define process",
          "input": "Name: 'Admission Process', 5 stages with value-add flags",
          "expected": "Process definition saved with stages JSONB"
        },
        {
          "step": 2,
          "action": "Set SLA",
          "input": "Target cycle time: 720 hours (30 days), SLA: 504 hours (21 days)",
          "expected": "SLA thresholds saved"
        },
        {
          "step": 3,
          "action": "Start process instance",
          "input": "Link to admission ID, trigger on status change",
          "expected": "Instance created with started_at, initial stage logged"
        },
        {
          "step": 4,
          "action": "Advance stage",
          "input": "Move from 'Document Collection' to 'Verification'",
          "expected": "Stage history updated, duration calculated"
        },
        {
          "step": 5,
          "action": "Complete process",
          "input": "Mark final stage complete",
          "expected": "Value-add ratio calculated, SLA status determined"
        },
        {
          "step": 6,
          "action": "Report waste incident",
          "input": "Category: 'W' (Waiting), Description: 'Approval delayed 48hrs'",
          "expected": "Waste incident logged, linked to process"
        },
        {
          "step": 7,
          "action": "View TIMWOOD breakdown",
          "input": "Navigate to waste analytics",
          "expected": "Pie chart showing distribution by waste category"
        },
        {
          "step": 8,
          "action": "View value-add metrics",
          "input": "Navigate to metrics dashboard",
          "expected": "Average value-add ratio displayed (target: >10%)"
        },
        {
          "step": 9,
          "action": "Generate audit report",
          "input": "Select period, click 'Generate Audit'",
          "expected": "Audit created with findings, A/B/C/D rating"
        },
        {
          "step": 10,
          "action": "Track SLA compliance",
          "input": "View SLA dashboard",
          "expected": "Shows on_track/at_risk/breached counts"
        }
      ]
