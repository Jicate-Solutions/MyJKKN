# ============================================
# MyJKKN Environment Variables
# ============================================

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your-project-url.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ============================================
# DEVELOPMENT AUTH MODE
# ============================================
# When true: Shows email/password login form on login page
# Used for testing with multiple user roles on dev sites
# Default: false (production uses Google OAuth only)
NEXT_PUBLIC_ENABLE_DEV_AUTH=false

# ============================================
# FEATURE FLAGS - Learners Module (Phase 3)
# ============================================
# IMPORTANT: Start with all flags set to false
# Enable modules one-by-one for gradual testing

# Master toggle for learners module
# When true: Replaces /admissions and /students with /learners
# When false: Uses old admission/student modules
NEXT_PUBLIC_USE_LEARNERS_PROFILES=false

# Granular module flags (for testing individual modules)
# Enquiries: Manage enquiry → pending applications
NEXT_PUBLIC_LEARNERS_ENQUIRIES=false

# Applications: Manage pending → approved/rejected workflow
NEXT_PUBLIC_LEARNERS_APPLICATIONS=false

# Profiles: Manage active/inactive students
NEXT_PUBLIC_LEARNERS_PROFILES=false

# Alumni: Manage graduated/exited learners
NEXT_PUBLIC_LEARNERS_ALUMNI=false

# Analytics: Unified lifecycle funnel dashboard
NEXT_PUBLIC_LEARNERS_ANALYTICS=false

# ============================================
# ROLLOUT SCHEDULE (Recommended)
# ============================================
# Week 1: Set LEARNERS_ENQUIRIES=true (test enquiry workflow)
# Week 2: Set LEARNERS_APPLICATIONS=true (test approval workflow)
# Week 3: Set LEARNERS_PROFILES=true (test student management)
# Week 4: Set LEARNERS_ALUMNI=true + LEARNERS_ANALYTICS=true
# Week 5: Set USE_LEARNERS_PROFILES=true (full switchover)
#
# Rollback: Set all to false and redeploy

# ============================================
# UNIFIED COMMUNICATION SUITE
# ============================================

# --- Email (Resend) ---
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM_ADDRESS=admissions@yourdomain.com
EMAIL_FROM_NAME=JKKN Admissions
EMAIL_REPLY_TO=admissions@yourdomain.com

# --- WhatsApp (Meta Cloud API) ---
WHATSAPP_ACCESS_TOKEN=your-permanent-access-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_BUSINESS_ACCOUNT_ID=your-business-account-id
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your-webhook-verify-token
WHATSAPP_APP_SECRET=your-app-secret

# --- Telephony (Exotel) ---
EXOTEL_API_KEY=your-api-key
EXOTEL_API_TOKEN=your-api-token
EXOTEL_ACCOUNT_SID=your-account-sid
EXOTEL_SUBDOMAIN=your-subdomain
EXOTEL_CALLER_ID=your-exotel-caller-id

# --- AI (Claude) ---
# Already configured if using admission AI features
# CLAUDE_API_KEY=sk-ant-xxxxxxxxx

# --- Google Ads Remarketing (optional) ---
# GOOGLE_ADS_CUSTOMER_ID=your-customer-id
# GOOGLE_ADS_DEVELOPER_TOKEN=your-developer-token
# GOOGLE_ADS_REFRESH_TOKEN=your-refresh-token

# --- Meta Pixel Remarketing (optional) ---
# META_PIXEL_ID=your-pixel-id
# META_PIXEL_ACCESS_TOKEN=your-access-token
