{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "ignoreCommand": "git diff \"${VERCEL_GIT_PREVIOUS_SHA:-HEAD~20}\" HEAD --quiet -- . ':(exclude)supabase' ':(exclude)docs' ':(exclude)specs' ':(exclude).claude' ':(exclude).github' ':(exclude)*.md' 2>/dev/null || exit 1",
  "regions": ["bom1"],
  "git": {
    "deploymentEnabled": false
  },
  "crons": [
    {
      "path": "/api/cron/notification-processor?secret=${CRON_SECRET}",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/dashboard/cron/refresh-sla-leaderboard",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/dashboard/cron/refresh-conversion-leaderboard",
      "schedule": "30 18 * * *"
    },
    {
      "path": "/api/dashboard/cron/ghost-sweep",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/dashboard/cron/queue-escalate",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/dashboard/cron/super-admin-digest",
      "schedule": "3 3 * * *"
    },
    {
      "path": "/api/dashboard/cron/decisions-verdict-check",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/sunday-wrap?secret=${CRON_SECRET}",
      "schedule": "30 15 * * 0"
    },
    {
      "path": "/api/cron/friday-reflection?secret=${CRON_SECRET}",
      "schedule": "30 10 * * 5"
    },
    {
      "path": "/api/cron/dashboard-work-items?secret=${CRON_SECRET}",
      "schedule": "7 * * * *"
    },
    {
      "path": "/api/cron/counselor-shift-flip?secret=${CRON_SECRET}",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/sync-inbound-calls",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/hostel-vacate-sla?secret=${CRON_SECRET}",
      "schedule": "17 */6 * * *"
    },
    {
      "path": "/api/cron/grievance-sla-breach-check?secret=${CRON_SECRET}",
      "schedule": "23 * * * *"
    },
    {
      "path": "/api/cron/generate-daily-briefings",
      "schedule": "30 0 * * *"
    },
    {
      "path": "/api/cron/sentry-lane-2?secret=${CRON_SECRET}",
      "schedule": "29 */6 * * *"
    },
    {
      "path": "/api/cron/attention-bar-prune?secret=${CRON_SECRET}",
