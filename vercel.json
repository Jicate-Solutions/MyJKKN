    {
      "path": "/api/cron/prospect-reminders?secret=${CRON_SECRET}",
      "schedule": "23 8 * * *"
    },
    {
      "path": "/api/cron/jicate-booking-reconcile",
      "schedule": "17 2 * * *"
    },
    {
      "path": "/api/cron/whatsapp-byow-health",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/whatsapp-byow-connection-pulse",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/whatsapp-byow-bypass-detect",
      "schedule": "0 9 * * 1"
    },
    {
      "path": "/api/cron/whatsapp-byow-monthly-audit",
      "schedule": "0 4 1 * *"
    },
    {
      "path": "/api/cron/whatsapp-byow-synthetic-audit",
