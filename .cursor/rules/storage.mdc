## Storage Service Structure
```typescript
// lib/storage/storage-service.ts
import { getSupabaseClient } from '@/lib/supabase/client';
import { createServerSupabaseClient } from '@/lib/supabase/server';
import { ErrorHandler } from '@/lib/utils/error-handler';

export class StorageService {
  // Bucket names as constants
  static BUCKET_PROFILES = 'profiles';
  static BUCKET_DOCUMENTS = 'documents';
  static BUCKET_IMAGES = 'images';
  
  // Get appropriate Supabase client
  private static getSupabase(isServer = false, admin = false) {
    if (isServer) {
      return createServerSupabaseClient();
    }
    return getSupabaseClient({ admin });
  }
  
  // Generate a unique file path for the given entity and file
  private static generateFilePath(entityType: string, entityId: string, fileName: string): string {
    const uniqueId = crypto.randomUUID().slice(0, 8);
    const sanitizedFileName = fileName.replace(/[^a-zA-Z0-9.-]/g, '_');
    return `${entityType}/${entityId}/${uniqueId}_${sanitizedFileName}`;
  }

  /**
   * Upload a file to Supabase storage
   * @param bucket - Storage bucket name
   * @param entityType - Type of entity (e.g., 'profiles', 'products')
   * @param entityId - ID of the entity
   * @param file - File to upload
   * @param isServer - Whether to use server client
   * @returns URL of the uploaded file
   */
  static async uploadFile(
    bucket: string,
    entityType: string,
    entityId: string,
    file: File,
    isServer = false
  ): Promise<string> {
    try {
      const supabase = this.getSupabase(isServer);
      
      // Validate file size and type
      if (file.size > 10 * 1024 * 1024) { // 10MB limit
        throw new Error('File size exceeds 10MB limit');
      }
      
      // Generate file path
      const filePath = this.generateFilePath(entityType, entityId, file.name);
      
      // Upload file
      const { data, error } = await supabase.storage
        .from(bucket)
        .upload(filePath, file, {
          upsert: true,
          contentType: file.type,
        });
      
      if (error) throw error;
      
      // Get public URL
      const { data: urlData } = supabase.storage
        .from(bucket)
        .getPublicUrl(data.path);
      
      return urlData.publicUrl;
    } catch (error) {
      ErrorHandler.handleError(error, 'uploadFile');
      throw error;
    }
  }
  
  /**
   * Delete a file from Supabase storage
   * @param bucket - Storage bucket name
   * @param filePath - Path of the file to delete
   * @param isServer - Whether to use server client
   */
  static async deleteFile(
    bucket: string,
    filePath: string,
    isServer = false
  ): Promise<void> {
    try {
      const supabase = this.getSupabase(isServer);
      
      const { error } = await supabase.storage
        .from(bucket)
        .remove([filePath]);
      
      if (error) throw error;
    } catch (error) {
      ErrorHandler.handleError(error, 'deleteFile');
      throw error;
    }
  }
  
  /**
   * List files in a directory
   * @param bucket - Storage bucket name
   * @param path - Directory path
   * @param isServer - Whether to use server client
   * @returns Array of file objects
   */
  static async listFiles(
    bucket: string,
    path: string,
    isServer = false
  ): Promise<any[]> {
    try {
      const supabase = this.getSupabase(isServer);
      
      const { data, error } = await supabase.storage
        .from(bucket)
        .list(path);
      
      if (error) throw error;
      
      return data || [];
    } catch (error) {
      ErrorHandler.handleError(error, 'listFiles');
      throw error;
    }
  }
  
  /**
   * Get a presigned URL for direct file upload
   * @param bucket - Storage bucket name
   * @param filePath - Path for the file
   * @param expiresIn - Seconds until expiration
   * @param isServer - Whether to use server client
   * @returns Presigned URL
   */
  static async getUploadUrl(
    bucket: string,
    filePath: string,
    expiresIn = 60, // 1 minute
    isServer = false
  ): Promise<string> {
    try {
      const supabase = this.getSupabase(isServer, true); // Admin client required
      
      const { data, error } = await supabase.storage
        .from(bucket)
        .createSignedUploadUrl(filePath, {
          expiresIn,
        });
      
      if (error) throw error;
      
      return data.signedUrl;
    } catch (error) {
      ErrorHandler.handleError(error, 'getUploadUrl');
      throw error;
    }
  }
}
```

## File Upload Component Pattern
```typescript
// components/forms/file-upload.tsx
'use client';

import { useState, useCallback } from 'react';
import { useDropzone } from 'react-dropzone';
import { Button } from '@/components/ui/button';
import { Progress } from '@/components/ui/progress';
import { StorageService } from '@/lib/storage/storage-service';
import toast from 'react-hot-toast';

interface FileUploadProps {
  bucket: string;
  entityType: string;
  entityId: string;
  acceptedFileTypes?: string[];
  maxSizeMB?: number;
  onUploadComplete?: (url: string) => void;
}

export function FileUpload({
  bucket,
  entityType,
  entityId,
  acceptedFileTypes = ['image/*', 'application/pdf'],
  maxSizeMB = 10,
  onUploadComplete,
}: FileUploadProps) {
  const [uploading, setUploading] = useState(false);
  const [progress, setProgress] = useState(0);
  
  const maxSizeBytes = maxSizeMB * 1024 * 1024;
  
  const onDrop = useCallback(async (acceptedFiles: File[]) => {
    if (acceptedFiles.length === 0) return;
    
    const file = acceptedFiles[0];
    
    try {
      setUploading(true);
      
      // Simulate progress for better UX
      const progressInterval = setInterval(() => {
        setProgress((prev) => {
          if (prev >= 95) {
            clearInterval(progressInterval);
            return 95;
          }
          return prev + 5;
        });
      }, 100);
      
      const publicUrl = await StorageService.uploadFile(
        bucket,
        entityType,
        entityId,
        file
      );
      
      clearInterval(progressInterval);
      setProgress(100);
      
      // Call callback with the URL
      onUploadComplete?.(publicUrl);
      
      toast.success('File uploaded successfully');
    } catch (error) {
      toast.error('Failed to upload file');
      console.error('Upload error:', error);
    } finally {
      setUploading(false);
      // Reset progress after delay
      setTimeout(() => setProgress(0), 2000);
    }
  }, [bucket, entityType, entityId, onUploadComplete]);
  
  const { getRootProps, getInputProps, isDragActive } = useDropzone({
    onDrop,
    accept: acceptedFileTypes.reduce((acc, type) => {
      acc[type] = [];
      return acc;
    }, {} as Record<string, string[]>),
    maxSize: maxSizeBytes,
    multiple: false,
    disabled: uploading,
  });
  
  return (
    <div className="space-y-4">
      <div
        {...getRootProps()}
        className={`
          border-2 border-dashed rounded-lg p-6 text-center cursor-pointer
          ${isDragActive ? 'border-primary bg-primary/5' : 'border-muted-foreground/25'}
          ${uploading ? 'opacity-50 cursor-not-allowed' : ''}
        `}
      >
        <input {...getInputProps()} />
        <div className="space-y-2">
          <div className="text-lg font-medium">
            {isDragActive ? 'Drop the file here' : 'Drag & drop a file here, or click to select'}
          </div>
          <p className="text-sm text-muted-foreground">
            Accepted file types: {acceptedFileTypes.join(', ')}
          </p>
          <p className="text-sm text-muted-foreground">
            Maximum size: {maxSizeMB}MB
          </p>
        </div>
      </div>
      
      {uploading && (
        <div className="space-y-2">
          <Progress value={progress} className="h-2" />
          <p className="text-sm text-center">Uploading... {progress}%</p>
        </div>
      )}
      
      <div className="flex justify-center">
        <Button
          variant="outline"
          onClick={() => document.querySelector<HTMLInputElement>('input[type=file]')?.click()}
          disabled={uploading}
        >
          Select File
        </Button>
      </div>
    </div>
  );
}
```

